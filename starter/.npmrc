# Versiones exactas: nunca ^ ni ~ al agregar paquetes
save-exact=true
# Falla si la version de node/pnpm no coincide con "engines"
engine-strict=true
# Seguridad: no instalar versiones publicadas hace menos de 1 dia (en minutos)
minimum-release-age=1440
# El lockfile es obligatorio y no se modifica en CI
prefer-frozen-lockfile=true
